{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/beta",
      "destination": "/signup"
    },
    {
      "source": "/eula",
      "destination": "/eula.html"
    },
    {
      "source": "/ai-disclosure",
      "destination": "/ai-disclosure.html"
    },
    {
      "source": "/connect-quickbooks",
      "destination": "/connect-quickbooks.html"
    },
    {
      "source": "/quickbooks-disconnected",
      "destination": "/quickbooks-disconnected.html"
    },
    {
      "source": "/terms",
      "destination": "/eula.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/acceptable-use",
      "destination": "/acceptable-use.html"
    },
    {
      "source": "/credits",
      "destination": "/credits.html"
    },
    {
      "source": "/refunds",
      "destination": "/refunds.html"
    },
    {
      "source": "/marketplace-terms",
      "destination": "/marketplace-terms.html"
    },
    {
      "source": "/subprocessors",
      "destination": "/subprocessors.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' https://api.atrovia.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.atrovia.co https://prod.atrovia.co; frame-src 'self' https://api.atrovia.co https://prod.atrovia.co https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com; media-src 'self' https:; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
